<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>PayItGlobalApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ApplicationTitle>CryptAply</ApplicationTitle>
		<ApplicationId>com.cryptaply.keymanager.app</ApplicationId>
		<ApplicationIdGuid>25f39401-8c74-4bc9-abeb-61c13bdb1fd7</ApplicationIdGuid>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net7.0-ios|AnyCPU'">
		<CreatePackage>false</CreatePackage>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
		<ProvisioningType>manual</ProvisioningType>
		<CodesignProvision>iOS Team Provisioning Profile: com.cryptaply.keymanager.app</CodesignProvision>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-ios|AnyCPU'">
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<!-- Include the LaunchScreen.storyboard -->
		<MauiAsset Include="Platforms\iOS\LaunchScreen.storyboard">
			<Link>Platforms\iOS\LaunchScreen.storyboard</Link>
		</MauiAsset>
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" BaseSize="50,99" />
		<!-- Other resources -->
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\avatars\*" />
		<MauiImage Include="Resources\Images\backgrounds\*" />
		<MauiImage Include="Resources\Images\topics\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Platforms\iOS\Program.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiImage Remove="Resources\Images\favorites_img.png" />
		<MauiImage Remove="Resources\Images\help_img.png" />
		<MauiImage Remove="Resources\Images\home_img.png" />
		<MauiImage Remove="Resources\Images\key_img.png" />
		<MauiImage Remove="Resources\Images\reports_img.png" />
		<MauiImage Remove="Resources\Images\search_img.png" />
		<MauiImage Remove="Resources\Images\start_course_button.png" />
		<MauiImage Remove="Resources\Images\team_img.png" />
		<MauiImage Remove="Resources\Images\videos_img.png" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\splash.svg" />
		<None Remove="Platforms\iOS\Resources\logoiossplash.svg" />
		<None Remove="Resources\Fonts\Kanit-Black.ttf" />
		<None Remove="Resources\Fonts\Kanit-BlackItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Bold.ttf" />
		<None Remove="Resources\Fonts\Kanit-BoldItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-ExtraBold.ttf" />
		<None Remove="Resources\Fonts\Kanit-ExtraBoldItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-ExtraLight.ttf" />
		<None Remove="Resources\Fonts\Kanit-ExtraLightItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Italic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Light.ttf" />
		<None Remove="Resources\Fonts\Kanit-LightItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Medium.ttf" />
		<None Remove="Resources\Fonts\Kanit-MediumItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Regular.ttf" />
		<None Remove="Resources\Fonts\Kanit-SemiBold.ttf" />
		<None Remove="Resources\Fonts\Kanit-SemiBoldItalic.ttf" />
		<None Remove="Resources\Fonts\Kanit-Thin.ttf" />
		<None Remove="Resources\Fonts\Kanit-ThinItalic.ttf" />
		<None Remove="Resources\Images\icontest.svg" />
		<None Remove="Resources\Images\key.svg" />
		<None Remove="Resources\Images\key_img.png" />
		<None Remove="Resources\Images\logo.png" />
		<None Remove="Resources\Images\logoandroidsplash.svg" />
		<None Remove="Resources\Images\splash.png" />
		<None Remove="Resources\Images\team.svg" />
		<None Remove="Resources\Images\team_img.png" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Images\key_img.png" />
		<EmbeddedResource Include="Resources\Images\reports_img.png" />
		<EmbeddedResource Include="Resources\Images\favorites_img.png" />
		<EmbeddedResource Include="Resources\Images\help_img.png" />
		<EmbeddedResource Include="Resources\Images\home_img.png" />
		<EmbeddedResource Include="Resources\Images\search_img.png" />
		<EmbeddedResource Include="Resources\Images\start_course_button.png" />
		<EmbeddedResource Include="Resources\Images\team_img.png" />
		<EmbeddedResource Include="Resources\Images\videos_img.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.90" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.90" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.90" />
		<PackageReference Include="Reactor.Maui" Version="2.0.47" />
		<PackageReference Include="Reactor.Maui.Canvas" Version="2.0.47" />
		<PackageReference Include="Reactor.Maui.ScaffoldGenerator" Version="2.0.14-beta" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PayItGlobalApp.Application\PayItGlobalApp.Application.csproj" />
		<ProjectReference Include="..\PayItGlobalApp.Infrastructure\PayItGlobalApp.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<BundleResource Include="Entitlements.plist" />
	</ItemGroup>

	<!-- Conditionally include network_security_config.xml only in Debug build -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidResource Include="Platforms/Android/Resources/xml/network_security_config.xml" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Platforms\iOS\Program.cs" />
	</ItemGroup>

   <ItemGroup>
        <MauiSplashScreen Include="Platforms\Android\Resources\logoandroidsplash.svg" Color="#FFFFFF" />
        <MauiImage Include="Platforms\iOS\Resources\logoiossplash.svg">
          <Color>#FFFFFF</Color>
        </MauiImage>
    </ItemGroup>
</Project>